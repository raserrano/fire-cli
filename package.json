{
  "name": "fire-cli",
  "version": "0.0.1",
  "description": "Track income and expenses on the CLI to get a wall chart to calculate #FIRE like #YMOYL style",
  "main": "index.js",
  "type": "module",
  "imports": {
    "#models/*.js": "./app/models/*.js",
    "#utils/*.js": "./app/utils/*.js",
    "#data/*.js": "./data/*.js"
  },
  "bin": {
    "fire-cli": "bin/cmd.js"
  },
  "scripts": {
    "test": "cucumber-js --tags 'not @skip' --format pretty --format-options '{\"pretty\":{\"useStatusIcon\":true}}'",
    "coverage": "c8 npm test",
    "coverage:html": "c8 report --reporter html",
    "lint": "standard . --fix",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raserrano/fire-cli.git"
  },
  "keywords": [
    "fire",
    "cli",
    "ymoyl",
    "money",
    "finance",
    "wallchart"
  ],
  "author": "raserrano",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/raserrano/fire-cli/issues"
  },
  "homepage": "https://github.com/raserrano/fire-cli#readme",
  "dependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "commander": "^15.0.0",
    "commitlint": "^21.2.1",
    "lowdb": "^7.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "husky": "^9.1.7",
    "npm-check-updates": "^23.0.1",
    "standard": "^17.1.2"
  }
}
